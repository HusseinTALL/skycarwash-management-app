# ── Database (Supabase PostgreSQL) ────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=<random-256-bit-base64-string>
JWT_EXPIRATION_MANAGER=604800     # 7 days (seconds)
JWT_EXPIRATION_EMPLOYEE=43200     # 12 hours (seconds)
JWT_EXPIRATION_PARTNER=604800     # 7 days (seconds)

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Firebase Cloud Messaging ──────────────────────────────────────────
# Path to your Firebase service account JSON file, or inline JSON via env var
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
