# ─────────────────────────────────────────────────────────────────────────────
# SkyCarWash – production environment variables
#
#   cp .env.example .env   and fill in real secrets before deploying.
#   docker compose -f docker-compose.prod.yml reads this file automatically.
#
# NEVER commit the real .env — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL ---
POSTGRES_DB=skycarwash
POSTGRES_USER=skycarwash
# Generate a strong one, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Backend security ---
# JWT signing secret — MUST be at least 32 characters.
# Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_secret

# --- CORS ---
# The app is single-origin, so this is mostly belt-and-suspenders.
# Set to the public URL users hit. Add your domain here once DNS is set up.
CORS_ORIGINS=http://161.97.183.139
