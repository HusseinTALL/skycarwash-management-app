# ─────────────────────────────────────────────────────────────────────────────
# Production environment for docker-compose.prod.yml
# Copy this file to ".env" on the server and fill in real values.
# NEVER commit the real .env — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-database-password

# JWT signing secret — must be a long random string (>= 32 characters).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# Public origin(s) allowed to call the API, comma-separated.
# The SPA is served same-origin (nginx proxies /api), so this is only needed
# if you call the API from another domain. Set it to your site for safety.
CORS_ORIGINS=https://your-domain.com
